# Kopieren nach ".env" und Werte anpassen.

# --- Lokale Entwicklung (npm run dev) --------------------------------
# Vollständige Verbindungs-URL zu einer lokalen/eigenen Postgres-Instanz.
# Wird beim Deployment via docker-compose NICHT benötigt (siehe unten).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sieben_dev?schema=public"

# --- Docker-Compose-Deployment ---------------------------------------
# Werden von docker-compose.yml verwendet, um DATABASE_URL automatisch
# für den app-Container zusammenzusetzen (Host "postgres" = Service-Name).
POSTGRES_USER="sieben"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="sieben"

# --- Gemeinsam (lokal & Docker) ---------------------------------------
# Auth.js – Secret zum Signieren von Sessions/JWTs.
# Erzeugen mit: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Öffentliche URL der Anwendung
NEXTAUTH_URL="https://24sieben.online"

# SMTP für Passwort-Reset-E-Mails (optional — ohne SMTP_HOST wird die
# Mail nur in die Server-Logs geschrieben, praktisch für lokale Tests)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="24sieben.online <no-reply@24sieben.online>"

# Initialer Admin-Account (nur für "npm run db:seed" relevant)
SEED_ADMIN_EMAIL="admin@24sieben.online"
SEED_ADMIN_PASSWORD="CHANGE_ME"
